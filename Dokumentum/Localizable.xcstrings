        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "1 Regel wird nicht angewendet, weil ihr Eintrag doppelt im Archiv ist."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Regeln werden nicht angewendet, weil ihr Eintrag doppelt im Archiv ist."
