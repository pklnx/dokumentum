          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags: %@"
          }
        }
      }
    },
    "the archive could not be opened" : {
      "comment" : "Reason in “Sync off: %@”: the archive's file could not be opened, so a separate fallback store opened.",
